ENVIRONMENT=development

# Météo-France API credentials and endpoints
METEOFRANCE_APP_ID=replace-with-your-application-id
METEOFRANCE_TOKEN_URL=replace-with-token-url
METEOFRANCE_BASE_URL=replace-with-api-base-url

# PostgreSQL
POSTGRES_USER=weather
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=weather
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace-with-a-strong-password
PGADMIN_PORT=5050

# Application
API_PORT=8001
SITE_ADDRESS=:80

# Required by Compose interpolation when the monitoring profile is enabled
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
